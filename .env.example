# Copy this file to .env and fill in every value.
# .env is git-ignored. On Vercel, add the same variables under Project Settings > Environment Variables.

# Neon Postgres connection string (use the DIRECT string: "Connection pooling" toggle OFF in the Neon dashboard).
# Used by the app (via the Neon driver adapter) and by Prisma migrations (prisma.config.ts).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js secret used to encrypt the session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# GitHub OAuth app credentials (GitHub > Settings > Developer settings > OAuth Apps).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Your numeric GitHub user id. Only this account can sign in to /admin.
# Find it at https://api.github.com/users/YOUR_USERNAME (the "id" field).
ADMIN_GITHUB_ID=""

# Public base URL of the site, no trailing slash. Used for sitemap, robots, canonical URLs, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary (Dashboard > Product environment credentials). Used for signed browser uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Brevo transactional email API key (Brevo > SMTP & API > API Keys).
BREVO_API_KEY=""

# Where new contact-form messages are sent (your inbox).
CONTACT_TO_EMAIL=""

# Sender address for notifications and auto-replies. Must be a verified sender or domain in Brevo.
CONTACT_FROM_EMAIL=""
